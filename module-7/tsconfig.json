    "rootDir": "./src",
    "outDir": "./dist",

    "module": "esnext",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts", "env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
